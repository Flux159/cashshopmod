name: Build and Release Mod Zip

on:
  push:
    tags:
      - 'v*' # Triggers whenever you push a tag starting with 'v' (e.g., v1.0.0)

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Create Zip Archive
        run: |
          # Exclude git metadata and workflow files from the user zip
          zip -r mod-release.zip . -x "*.git*" ".github/*"

      - name: Release Zip to GitHub
        uses: softprops/action-gh-release@v2
        with:
          files: mod-release.zip
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
